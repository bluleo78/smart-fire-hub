# === PostgreSQL ===
POSTGRES_DB=smartfirehub
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-secure-password

# === MinIO (오브젝트 스토리지 — FILE 데이터셋) ===
# api 서비스는 이 값들을 MINIO_ACCESS_KEY/MINIO_SECRET_KEY 로 내부에서 매핑해서 읽는다
# (docker-compose.prod.yml api.environment 참고 — 변수명이 달라 직접 재사용할 수 없음).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-prod
MINIO_BUCKET=firehub-files

# === firehub-api (Spring Boot) ===
# JWT 서명 키 (Base64 인코딩, 256비트 이상)
JWT_SECRET=
# 암호화 마스터 키 (Base64 인코딩)
ENCRYPTION_MASTER_KEY=
# AI Agent 내부 인증 토큰
AGENT_INTERNAL_TOKEN=change-me-to-a-random-token

# === firehub-ai-agent (Node.js) ===
# AI 자격증명(ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN)은 여기 두지 않는다 — 테넌트 설정(설정 › AI 에이전트)에서
# 요청마다 전달되며 ai-agent 는 ambient 값을 쓰지 않는다(#708). 키체인 로그인 폴백도 없다.
# 에이전트 최대 턴 수
MAX_TURNS=10

# === 옵션 ===
# 웹 서버 포트 (기본: 80)
# WEB_PORT=80

# db-executor(Tibero 전담 실행기) 자격 — 아래 값은 모두 서로 다른 임의 문자열로 바꾼다.
# api 와 db-executor 가 공유하는 전 창구 내부 토큰(Python 실행기 토큰과 달라야 한다)
DB_EXECUTOR_INTERNAL_TOKEN=change-me-db-executor-internal-token
# Python 실행기 전용 적재 토큰(/execute/load 만 허용, 내부 토큰과 달라야 한다)
DB_EXECUTOR_LOAD_TOKEN=change-me-db-executor-load-token
# 스크립트 1회용 토큰 서명 키(api 와 db-executor 가 같은 값)
DB_EXECUTOR_SCRIPT_TOKEN_KEY=change-me-db-executor-script-token-key
# Python 실행기가 적재를 보낼 db-executor 주소(compose 에서는 서비스명 사용)
EXECUTOR_DB_EXECUTOR_BASE_URL=http://db-executor:8090
# Python 실행기가 쓰는 적재 토큰 — DB_EXECUTOR_LOAD_TOKEN 과 같은 값
EXECUTOR_DB_EXECUTOR_LOAD_TOKEN=change-me-db-executor-load-token
