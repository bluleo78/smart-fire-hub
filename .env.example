# === PostgreSQL ===
POSTGRES_DB=smartfirehub
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-secure-password

# === MinIO (오브젝트 스토리지 — FILE 데이터셋) ===
# api 서비스는 이 값들을 MINIO_ACCESS_KEY/MINIO_SECRET_KEY 로 내부에서 매핑해서 읽는다
# (docker-compose.prod.yml api.environment 참고 — 변수명이 달라 직접 재사용할 수 없음).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-prod
MINIO_BUCKET=firehub-files

# === firehub-api (Spring Boot) ===
# JWT 서명 키 (Base64 인코딩, 256비트 이상)
JWT_SECRET=
# 암호화 마스터 키 (Base64 인코딩)
ENCRYPTION_MASTER_KEY=
# AI Agent 내부 인증 토큰
AGENT_INTERNAL_TOKEN=change-me-to-a-random-token

# === firehub-ai-agent (Node.js) ===
# Anthropic API 키 — 요청에서 apiKey를 받지 않을 경우 폴백으로 사용
# ANTHROPIC_API_KEY=
# 에이전트 최대 턴 수
MAX_TURNS=10

# === 옵션 ===
# 웹 서버 포트 (기본: 80)
# WEB_PORT=80
