{
  "name": "smart-fire-hub",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "mkdir -p logs && lsof -ti:5010,5040,5020,5030,5050,5173 | xargs kill -9 2>/dev/null; turbo run dev 2>&1 | tee logs/dev-server.log",
    "dev:full": "pnpm db:up && mkdir -p logs && lsof -ti:5010,5040,5020,5030,5050,5173 | xargs kill -9 2>/dev/null; turbo run dev 2>&1 | tee logs/dev-server.log",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:full": "sh scripts/husky/full-regression.sh",
    "test:hooks": "for t in scripts/husky/*.test.sh; do sh \"$t\" || exit 1; done && node --test scripts/check-migration-versions.test.mjs",
    "train": "sh scripts/husky/train.sh",
    "check:migrations": "node scripts/check-migration-versions.mjs",
    "test:e2e": "pnpm --filter firehub-web test:e2e",
    "test:e2e:ui": "pnpm --filter firehub-web test:e2e:ui",
    "test:e2e:headed": "pnpm --filter firehub-web test:e2e:headed",
    "test:e2e:admin": "pnpm --filter @smart-fire-hub/firehub-admin test:e2e",
    "clean": "turbo run clean",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f db",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "turbo": "^2.5.0"
  },
  "lint-staged": {
    "apps/firehub-web/{src,e2e}/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored --config apps/firehub-web/eslint.config.js"
    ],
    "apps/firehub-admin/{src,e2e}/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored --config apps/firehub-admin/eslint.config.js"
    ],
    "apps/firehub-ai-agent/src/**/*.ts": [
      "eslint --no-warn-ignored --config apps/firehub-ai-agent/eslint.config.js"
    ]
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/node": "^24.10.1",
      "proxy-addr": "^2.0.8",
      "fast-uri@3": "^3.1.9",
      "js-yaml@4": "^4.3.2",
      "body-parser@1": "^1.20.9",
      "body-parser@2": "^2.4.0",
      "path-to-regexp@0": "^0.1.13",
      "path-to-regexp@8": "^8.4.0",
      "hono": "^4.13.16",
      "express-rate-limit": "^8.2.2",
      "form-data@4": "^4.0.6",
      "ip-address": "^10.7.4",
      "ws@8": "^8.21.0",
      "qs@6": "^6.16.1",
      "ajv@8": "^8.18.0",
      "@hono/node-server@1": "^1.19.18",
      "@modelcontextprotocol/sdk@^1.32.0>@hono/node-server": "^2.1.3"
    }
  }
}
