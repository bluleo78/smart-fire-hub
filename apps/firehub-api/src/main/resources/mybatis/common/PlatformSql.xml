<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  플랫폼 매퍼 공용 SQL 조각(WD-487 PoC). 벤더 규칙(databaseId·테넌트·null 바인드)은 MyBatisPlatformConfig javadoc 참조.
  매퍼 인터페이스 없는 조각 전용 namespace 라 다른 XML 이 namespace.id 로 include 한다.
-->
<mapper namespace="com.smartfirehub.global.platformdb.mybatis.PlatformSql">

  <!-- 불리언 리터럴. Tibero 불리언 컬럼은 NUMBER(1) 이다. -->
  <sql id="sqlTrue" databaseId="postgresql">TRUE</sql>
  <sql id="sqlTrue" databaseId="tibero">1</sql>
  <sql id="sqlFalse" databaseId="postgresql">FALSE</sql>
  <sql id="sqlFalse" databaseId="tibero">0</sql>

  <!-- 사용자 테이블 이름. PG 는 예약어라 소문자 따옴표, Tibero 기준선은 따옴표 대문자 "USER" 다(WD-706). -->
  <sql id="userTable" databaseId="postgresql">"user"</sql>
  <sql id="userTable" databaseId="tibero">"USER"</sql>

  <!--
    resource 열 이름(audit_log·async_job). PG 는 그냥 resource, Tibero 기준선은 예약어라 따옴표 대문자 "RESOURCE" 다(WD-706).
    SELECT 에서 별칭 없이 쓰면 결과 열 라벨이 벤더마다 대소문자가 달라도 MyBatis 가 대소문자 무시로 맞춘다.
  -->
  <sql id="resourceColumn" databaseId="postgresql">resource</sql>
  <sql id="resourceColumn" databaseId="tibero">"RESOURCE"</sql>

  <!-- DB 시계. PG 는 now(), Tibero 는 UTC 벽시계 TIMESTAMP 라 SYS_EXTRACT_UTC(SYSTIMESTAMP) 다. -->
  <sql id="dbNow" databaseId="postgresql">now()</sql>
  <sql id="dbNow" databaseId="tibero">SYS_EXTRACT_UTC(SYSTIMESTAMP)</sql>

  <!-- JSON 컬럼을 문자열로 읽는다(속성 col·alias). PG 는 jsonb 를 text 로 바꾸고, Tibero JSON 열은 getString 으로 문자열 그대로 읽힌다(실측). -->
  <sql id="jsonText" databaseId="postgresql">${col}::text AS ${alias}</sql>
  <sql id="jsonText" databaseId="tibero">${col} AS ${alias}</sql>

  <!-- 행 수 상한(잠금 없는 조회 전용). 속성 n 은 XML 에 박힌 고정 숫자다. Tibero 는 LIMIT 대신 FETCH FIRST(NULLS LAST 와 함께 쓸 수 있음, 실측). -->
  <sql id="limitRows" databaseId="postgresql">LIMIT ${n}</sql>
  <sql id="limitRows" databaseId="tibero">FETCH FIRST ${n} ROWS ONLY</sql>

  <!-- 페이지(파라미터 limit·offset). Tibero 는 OFFSET … ROWS FETCH NEXT … ROWS ONLY(바인드 가능, 실측). -->
  <sql id="pageClause" databaseId="postgresql">LIMIT #{limit} OFFSET #{offset}</sql>
  <sql id="pageClause" databaseId="tibero">OFFSET #{offset} ROWS FETCH NEXT #{limit} ROWS ONLY</sql>

</mapper>
