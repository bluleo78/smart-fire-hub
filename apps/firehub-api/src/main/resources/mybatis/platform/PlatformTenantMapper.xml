<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  운영자 평면 tenant·membership 문장(WD-706) — JooqPlatformTenantRepository 와 같은 의미. 규칙은 MyBatisPlatformConfig javadoc,
  공용 조각(userTable)은 mybatis/common/PlatformSql.xml.
  tenant·membership·user 는 테넌트 경계 위의 전역 테이블(정책·tenant_id DEFAULT 없음)이라 운영자 토큰(테넌트 컨텍스트 없음)으로도
  전 테넌트가 보인다. 그래서 membership 의 tenant_id 는 인터페이스가 받은 인자로 직접 건다(전역 제약의 「테넌트를 인자로 받는 문장」 예외).
  빈 문자열(controller Ruling): 변환하지 않는다 — Tibero 는 '' 를 NULL 로 저장한다(slug NULL 허용 → NULL, name NOT NULL → 거절).
  created_at 은 저장 TZ 벽시계 TIMESTAMP 를 LocalDateTime 으로 그대로 읽는다(Tibero 는 UTC 벽시계 — DTO 직렬화기가 오프셋을 붙인다).
-->
<mapper namespace="com.smartfirehub.platform.repository.mybatis.PlatformTenantMapper">

  <resultMap id="tenantSummary" type="com.smartfirehub.platform.dto.TenantSummaryResponse">
    <constructor>
      <idArg column="id" javaType="java.lang.Long"/>
      <arg column="slug" javaType="java.lang.String"/>
      <arg column="name" javaType="java.lang.String"/>
      <arg column="status" javaType="java.lang.String"/>
      <arg column="member_count" javaType="_int"/>
      <arg column="created_at" javaType="java.time.LocalDateTime"/>
    </constructor>
  </resultMap>

  <resultMap id="tenantMember" type="com.smartfirehub.platform.dto.TenantMemberResponse">
    <constructor>
      <idArg column="user_id" javaType="java.lang.Long"/>
      <arg column="username" javaType="java.lang.String"/>
      <arg column="email" javaType="java.lang.String"/>
      <arg column="role" javaType="java.lang.String"/>
      <arg column="status" javaType="java.lang.String"/>
      <arg column="is_active" javaType="_boolean"/>
    </constructor>
  </resultMap>

  <!-- 멤버 수는 상태 무관(ACTIVE + SUSPENDED) 상관 서브쿼리 — membership 이 전역 테이블이라 컨텍스트 없이 센다. -->
  <sql id="summaryColumns">
    t.id, t.slug, t.name, t.status, t.created_at,
    (SELECT COUNT(*) FROM membership m WHERE m.tenant_id = t.id) AS member_count
  </sql>

  <!-- id 는 IDENTITY 가 채운다(PG BIGSERIAL, Tibero GENERATED BY DEFAULT). slug 는 NULL 허용이라 null 바인드 타입을 밝힌다. -->
  <insert id="insertTenant" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO tenant (slug, name, status) VALUES (#{slug,jdbcType=VARCHAR}, #{name,jdbcType=VARCHAR}, 'ACTIVE')
  </insert>

  <!-- PG: 이미 있으면 무시. 이 문장은 테넌트 생성 트랜잭션 안에서 불리므로 INSERT 후 예외를 삼키는 방식은 쓰지 않는다(PG 트랜잭션이 중단된다). -->
  <insert id="insertOwnerMembership" databaseId="postgresql">
    INSERT INTO membership (user_id, tenant_id, role, status)
    VALUES (#{userId}, #{tenantId}, 'OWNER', 'ACTIVE')
    ON CONFLICT (user_id, tenant_id) DO NOTHING
  </insert>

  <!-- Tibero: ON CONFLICT 가 없어 MERGE 의 NOT MATCHED 분기만 쓴다(있는 행은 라벨·상태를 바꾸지 않는다). 동시 삽입 경합은 구현이 삼킨다. -->
  <insert id="insertOwnerMembership" databaseId="tibero">
    MERGE INTO membership m
    USING (SELECT #{userId} AS user_id, #{tenantId} AS tenant_id FROM DUAL) s
       ON (m.user_id = s.user_id AND m.tenant_id = s.tenant_id)
    WHEN NOT MATCHED THEN INSERT (user_id, tenant_id, role, status)
      VALUES (s.user_id, s.tenant_id, 'OWNER', 'ACTIVE')
  </insert>

  <!-- 존재 확인은 COUNT 로 — Tibero 는 FROM 없는 SELECT EXISTS 식이 없다. -->
  <select id="countBySlug" resultType="_int">
    SELECT COUNT(*) FROM tenant WHERE slug = #{slug,jdbcType=VARCHAR}
  </select>

  <select id="countById" resultType="_int">
    SELECT COUNT(*) FROM tenant WHERE id = #{tenantId}
  </select>

  <select id="selectAll" resultMap="tenantSummary">
    SELECT <include refid="summaryColumns"/> FROM tenant t ORDER BY t.id
  </select>

  <select id="selectById" resultMap="tenantSummary">
    SELECT <include refid="summaryColumns"/> FROM tenant t WHERE t.id = #{tenantId}
  </select>

  <!-- status &lt;&gt; 조건이 동시 요청을 가른다(WD-322) — 뒤 요청은 앞 요청 커밋 뒤 조건을 다시 평가해 0 행이 된다. -->
  <update id="updateStatus">
    UPDATE tenant SET status = #{status,jdbcType=VARCHAR}
     WHERE id = #{tenantId} AND status &lt;&gt; #{status,jdbcType=VARCHAR}
  </update>

  <!-- 테넌트 평면 role 은 읽지 않는다(정책 테이블 — 운영자에게 컨텍스트가 없다). membership.role 은 표시용 라벨이다. -->
  <select id="selectMembers" resultMap="tenantMember">
    SELECT u.id AS user_id, u.username, u.email, m.role, m.status, u.is_active
      FROM membership m
      JOIN <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.userTable"/> u ON u.id = m.user_id
     WHERE m.tenant_id = #{tenantId}
     ORDER BY u.id
  </select>
</mapper>
