<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  운영자 평면 사용자 검색·계정 목록 문장(WD-706) — JooqPlatformUserRepository 와 같은 의미. 규칙은 MyBatisPlatformConfig javadoc,
  공용 조각(userTable·불리언·페이지)은 mybatis/common/PlatformSql.xml.
  user·membership·platform_user_role 은 정책 없는 전역 테이블이라 테넌트 컨텍스트 없이 전 테넌트 사용자가 보인다. role·user_role(정책 테이블)은
  조인하지 않는다 — 컨텍스트 없는 운영자 토큰에서 예외 없이 0행이 되는 조용한 무동작을 막는다.
  대소문자 무시는 jOOQ ILIKE/equalIgnoreCase 대신 LOWER() 로 두 벤더 공통이다. 정렬은 email ASC 에서 NULL 이 두 벤더 모두 뒤로 간다.
  Tibero 는 SELECT 목록에 EXISTS 불리언을 둘 수 없어 운영자 여부를 CASE … THEN 1 ELSE 0 으로 읽는다.
-->
<mapper namespace="com.smartfirehub.platform.repository.mybatis.PlatformUserMapper">

  <resultMap id="platformUser" type="com.smartfirehub.platform.dto.PlatformUserResponse">
    <constructor>
      <idArg column="id" javaType="java.lang.Long"/>
      <arg column="email" javaType="java.lang.String"/>
      <arg column="name" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <resultMap id="platformAccount" type="com.smartfirehub.platform.dto.PlatformAccountResponse">
    <constructor>
      <idArg column="id" javaType="java.lang.Long"/>
      <arg column="username" javaType="java.lang.String"/>
      <arg column="email" javaType="java.lang.String"/>
      <arg column="name" javaType="java.lang.String"/>
      <arg column="is_active" javaType="_boolean"/>
      <arg column="is_operator" javaType="_boolean"/>
      <arg column="membership_count" javaType="_int"/>
      <arg column="created_at" javaType="java.time.LocalDateTime"/>
    </constructor>
  </resultMap>

  <sql id="fromUser">FROM <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.userTable"/> u</sql>

  <!-- 이메일 정확일치(대소문자 무시)면 0 — ORDER BY 에서 먼저 온다. 동순위는 id 로 결정적으로 자른다. -->
  <sql id="searchOrder">
    ORDER BY CASE WHEN LOWER(u.email) = LOWER(#{q}) THEN 0 ELSE 1 END ASC, u.email ASC, u.name ASC, u.id ASC
  </sql>

  <select id="search" resultMap="platformUser">
    SELECT u.id, u.email, u.name <include refid="fromUser"/>
     WHERE (LOWER(u.email) LIKE LOWER(#{pattern}) ESCAPE '\' OR LOWER(u.name) LIKE LOWER(#{pattern}) ESCAPE '\')
       AND u.is_active = <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.sqlTrue"/>
     <include refid="searchOrder"/>
     <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.pageClause"/>
  </select>

  <!-- 계정 화면 검색은 비활성도 포함하고 username 까지 맞춘다. -->
  <sql id="accountFilter">
    <if test="pattern != null">
      WHERE (LOWER(u.email) LIKE LOWER(#{pattern}) ESCAPE '\'
         OR LOWER(u.name) LIKE LOWER(#{pattern}) ESCAPE '\'
         OR LOWER(u.username) LIKE LOWER(#{pattern}) ESCAPE '\')
    </if>
  </sql>

  <select id="countAccounts" resultType="long">
    SELECT COUNT(*) <include refid="fromUser"/> <include refid="accountFilter"/>
  </select>

  <!-- 소속 수는 상태 무관(ACTIVE + SUSPENDED) membership 행 수, 운영자 여부는 platform_user_role 존재(둘 다 전역 테이블). -->
  <select id="selectAccounts" resultMap="platformAccount">
    SELECT u.id, u.username, u.email, u.name, u.is_active,
           CASE WHEN EXISTS (SELECT 1 FROM platform_user_role pur WHERE pur.user_id = u.id) THEN 1 ELSE 0 END AS is_operator,
           (SELECT COUNT(*) FROM membership m WHERE m.user_id = u.id) AS membership_count,
           u.created_at
      <include refid="fromUser"/> <include refid="accountFilter"/>
     <choose>
       <when test="pattern != null"><include refid="searchOrder"/></when>
       <otherwise>ORDER BY u.created_at DESC, u.id DESC</otherwise>
     </choose>
     <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.pageClause"/>
  </select>
</mapper>
