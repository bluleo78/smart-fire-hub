<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  document_chunk 문장(WD-712) — JooqDocumentChunkRepository 의 살아 있는 경로(deleteByDocumentFileId·insertChunksOnly·
  findChunkContentsByDataset·countChunksInDataset·countAllChunks)와 같은 의미. 규칙은 MyBatisPlatformConfig javadoc.
  테넌트 정책(RLS) 대상이라 tenant_id 를 쓰지 않는다(넣을 때는 DEFAULT 가 채우고 정책이 좁힌다).
  벡터 테이블(document_chunk_vec_N)·트라이그램 문장은 두지 않는다 — 벡터 저장소 포트(ChunkVectorIndex, ADR 0002)가 맡는다.
  표시 열(embedded_dim·embedded_model, WD-717)과 판정식은 플랫폼 DB 에 남아 여기 있다(WD-718, jOOQ 판 MISSING_PREDICATE 와 같은 식). metadata(jsonb/JSON) 열은 인터페이스의 어떤 메서드도 읽거나 쓰지 않아(jOOQ 판과 같음) 문장에 없다.
-->
<mapper namespace="com.smartfirehub.document.repository.mybatis.DocumentChunkMapper">

  <resultMap id="chunkContent" type="com.smartfirehub.document.repository.DocumentChunkRepository$ChunkContent">
    <constructor>
      <arg column="id" javaType="_long"/>
      <arg column="content" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <delete id="deleteByDocumentFileId">
    DELETE FROM document_chunk WHERE document_file_id = #{documentFileId}
  </delete>

  <!--
    청크 한 건. 구현이 청크마다 이 문장을 돈다 — Tibero 에는 다건 VALUES 가 없고, INSERT ALL 은 IDENTITY 를 한 문장에 한 번만 매겨
    둘째 행부터 PK 중복(JDBC-4008)으로 실패한다(실측). 값은 VALUES 에 바로 바인드해 수만 바이트 본문이 SQL 식 4000바이트 한도에 걸리지
    않게 한다. id 는 IDENTITY, tenant_id 는 컨텍스트 DEFAULT 가 채운다. 생성 id 는 생성 키로 돌려받는다(WD-720 — 벡터를 커밋 뒤에 쓰려면
    청크 id 가 필요하다, Tibero 에는 RETURNING 이 없다). content_hash 는 Java(SourceHash)가 계산한 본문 해시다.
  -->
  <insert id="insertChunk" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO document_chunk (document_file_id, dataset_id, chunk_index, content, token_count, content_hash)
    VALUES (#{documentFileId}, #{datasetId}, #{chunk.index}, #{chunk.content,jdbcType=VARCHAR}, #{chunk.tokenCount},
            #{contentHash,jdbcType=VARCHAR})
  </insert>

  <resultMap id="chunkRef" type="com.smartfirehub.vectorstore.ChunkRef">
    <constructor>
      <arg column="id" javaType="_long"/>
      <arg column="dataset_id" javaType="_long"/>
      <arg column="document_file_id" javaType="_long"/>
    </constructor>
  </resultMap>

  <!-- 벡터를 쓰기 전에 지금 있는 청크와 그 데이터셋·문서를 읽는다(사라진 청크는 빠진다). id 목록은 500 개씩 OR(Tibero IN 상한). -->
  <select id="selectRefs" resultMap="chunkRef">
    SELECT id, dataset_id, document_file_id FROM document_chunk
     WHERE <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.inChunks"><property name="col" value="id"/></include>
  </select>

  <select id="selectChunkContentsByDataset" resultMap="chunkContent">
    SELECT id, content FROM document_chunk WHERE dataset_id = #{datasetId} ORDER BY id
  </select>

  <!-- id 목록은 InChunks 로 500 개씩 나눠 OR 로 잇는다(Tibero IN 목록 1000 개 상한). 행 하나는 한 번만 세진다. -->
  <select id="countChunksInDataset" resultType="long">
    SELECT count(*) FROM document_chunk
     WHERE dataset_id = #{datasetId}
       AND <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.inChunks"><property name="col" value="id"/></include>
  </select>

  <!--
    등급 허용 술어는 공용 조각 DatasetVisibility.aiPolicyAllowedDataset(데이터셋 임베딩 매퍼와 함께 쓴다). 허용 값은 구현이
    MyBatisDatasetVisibility.aiPolicyValues 로 정한다.
  -->
  <select id="countAllowed" resultType="long">
    SELECT count(*) FROM document_chunk c
     WHERE <include refid="com.smartfirehub.securitylevel.repository.mybatis.DatasetVisibility.aiPolicyAllowedDataset"><property name="datasetIdCol" value="c.dataset_id"/></include>
  </select>

  <!-- 판정식: 표시 열이 현재 공간(차원·모델)을 가리키지 않는 청크(jOOQ 판 MISSING_PREDICATE 와 같음). -->
  <sql id="missingPredicate">
    (c.embedded_dim IS NULL OR c.embedded_dim &lt;&gt; #{dim} OR c.embedded_model IS NULL OR c.embedded_model &lt;&gt; #{model})
  </sql>

  <!-- 표시 열 채우기 — 포트로 벡터를 쓴 뒤 같은 트랜잭션에서. id 목록은 InChunks 로 500 개씩(Tibero IN 상한). -->
  <update id="markEmbedded">
    UPDATE document_chunk SET embedded_dim = #{dim}, embedded_model = #{model}
     WHERE <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.inChunks"><property name="col" value="id"/></include>
  </update>

  <!-- 데이터셋들의 청크 표시 열 비우기 — 벡터를 지운 뒤 같은 트랜잭션에서. tenant_id 를 명시한다. -->
  <update id="clearMarkersOfDatasets">
    UPDATE document_chunk SET embedded_dim = NULL, embedded_model = NULL
     WHERE tenant_id = #{tenantId}
       AND <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.inChunks"><property name="col" value="dataset_id"/></include>
  </update>

  <!-- 다른 차원을 가리키던 표시 열 비우기(차원 정리 뒤). -->
  <update id="clearOtherDimensionMarkers">
    UPDATE document_chunk SET embedded_dim = NULL, embedded_model = NULL
     WHERE tenant_id = #{tenantId} AND embedded_dim &lt;&gt; #{keepDim}
  </update>

  <select id="countEmbedded" resultType="long">
    SELECT count(*) FROM document_chunk WHERE embedded_dim = #{dim} AND embedded_model = #{model}
  </select>

  <select id="countMissing" resultType="long">
    SELECT count(*) FROM document_chunk c
     WHERE <include refid="missingPredicate"/>
       AND <include refid="com.smartfirehub.securitylevel.repository.mybatis.DatasetVisibility.aiPolicyAllowedDataset"><property name="datasetIdCol" value="c.dataset_id"/></include>
  </select>

  <!-- 키셋 페이지(id 순). 상한은 pageClause(offset 0). -->
  <select id="findMissing" resultMap="chunkContent">
    SELECT c.id, c.content FROM document_chunk c
     WHERE c.id &gt; #{afterChunkId}
       AND <include refid="missingPredicate"/>
       AND <include refid="com.smartfirehub.securitylevel.repository.mybatis.DatasetVisibility.aiPolicyAllowedDataset"><property name="datasetIdCol" value="c.dataset_id"/></include>
     ORDER BY c.id
     <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.pageClause"/>
  </select>

  <!-- 청크 키워드 표시(WD-720) — 데이터셋 매퍼 markKeywordIndexed 와 같은 규칙. -->
  <update id="markKeywordIndexed">
    UPDATE document_chunk SET keyword_marker = #{marker}, content_hash = COALESCE(content_hash, #{hash})
     WHERE id = #{chunkId} AND (content_hash IS NULL OR content_hash = #{hash})
  </update>

  <resultMap id="chunkSource" type="com.smartfirehub.document.repository.DocumentChunkRepository$ChunkSource">
    <constructor>
      <arg column="id" javaType="_long"/>
      <arg column="dataset_id" javaType="_long"/>
      <arg column="document_file_id" javaType="_long"/>
      <arg column="content" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <!-- 청크 키워드 백로그(키셋) — jOOQ 판 findKeywordMissing 과 같은 판정. -->
  <select id="findKeywordMissing" resultMap="chunkSource">
    SELECT c.id, c.dataset_id, c.document_file_id, c.content FROM document_chunk c
     WHERE c.id &gt; #{afterChunkId}
       AND (c.keyword_marker IS NULL OR c.content_hash IS NULL OR c.keyword_marker &lt;&gt; (#{prefix} || c.content_hash))
     ORDER BY c.id
     <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.pageClause"/>
  </select>

</mapper>
