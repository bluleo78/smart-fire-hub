<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  대시보드 가시성 공유 SQL 조각(WD-707) — JooqAnalyticsDashboardRepository.visibleTo(userId) 의 MyBatis 판.
  조회자에게 보이는 대시보드 = 본인이 만들었거나(created_by) 공유된 것(is_shared). 데이터셋 참조(묶음 ②)가 먼저 쓰고
  대시보드 리포지토리(묶음 ⑤)가 그대로 재사용한다 — 규칙을 복사하면 한쪽만 바뀌는 순간 볼 수 없는 대시보드 이름이 새어 나가므로
  (WD-143) 이 한 곳만 고친다.

  쓰는 법: 문장이 조회자 id 를 파라미터 이름 "userId" 로 받고, 별칭 없는 dashboard 테이블(jOOQ 조건과 같은 전제)이 FROM 에 있어야 한다.
    WHERE 에서:   AND <include refid="com.smartfirehub.analytics.repository.mybatis.DashboardVisibility.dashboardVisibleTo"/>
    SELECT 에서:  CASE WHEN <include refid="…dashboardVisibleTo"/>
                  THEN <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.sqlTrue"/>
                  ELSE <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.sqlFalse"/> END AS visible
  SELECT 목록에 술어를 바로 못 두는 이유: Tibero 에는 불리언 값 식이 없다. CASE 로 감싸면 PG 는 boolean, Tibero 는 NUMBER(1) 이
  나오고 _boolean 결과 매핑이 둘 다 받는다. userId 가 null 이면 두 DB 모두 거짓(created_by NOT NULL 이라 jOOQ 판과 같다).

  벤더 차이는 불리언 리터럴뿐이라 공용 조각(PlatformSql.sqlTrue)으로 한 본문을 쓴다(Tibero 불리언 컬럼은 NUMBER(1)).
-->
<mapper namespace="com.smartfirehub.analytics.repository.mybatis.DashboardVisibility">

  <sql id="dashboardVisibleTo">(dashboard.created_by = #{userId} OR dashboard.is_shared = <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.sqlTrue"/>)</sql>

  <!--
    소유 또는 공유 조각(WD-710, 스펙 D4) — 차트·저장 쿼리의 visibleTo(userId)(JooqChartRepository·JooqSavedQueryRepository) MyBatis 판.
    대시보드 조각과 같은 규칙(created_by = 조회자 OR is_shared)을 표 별칭만 바꿔 쓴다 — 세 곳이 한 규칙을 따로 복사하면 한쪽만 바뀌는
    순간 남의 비공유 차트·쿼리가 새어 나가므로 이 파일에 함께 둔다.

    쓰는 법: 속성 alias 에 FROM 의 표 별칭(XML 에 박힌 고정 값 — 사용자 입력 아님)을 넘기고, 조회자 id 는 파라미터 이름 "userId" 로 받는다.
      AND <include refid="com.smartfirehub.analytics.repository.mybatis.DashboardVisibility.ownedOrShared"><property name="alias" value="sq"/></include>
    SELECT 목록의 불리언으로 쓸 때는 dashboardVisibleTo 와 같이 CASE WHEN … THEN sqlTrue ELSE sqlFalse END 로 감싼다.
    속성을 빠뜨리면 런타임 파라미터 조회로 바뀌어 "no getter for alias" 오류가 난다. userId 가 null 이면 공유된 것만 참이다(jOOQ eq(null) 과 같다).
  -->
  <sql id="ownedOrShared">(${alias}.created_by = #{userId} OR ${alias}.is_shared = <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.sqlTrue"/>)</sql>

  <!--
    목록·건수·폴더가 함께 쓰는 소유/공유 범위(WD-328, WD-710 C4) — 차트·저장 쿼리 jOOQ listScope 의 MyBatis 판. 둘 다 거짓이면 내 것 + 공유된 것
    (ownedOrShared), shared 면 공유만, mine 이면 내 것만, 둘 다면 AND(내가 만든 공유 자산). 차트·저장 쿼리가 같은 분기를 따로 복사하지 않게 여기 둔다.
    쓰는 법: 속성 alias(XML 에 박힌 표 별칭), 파라미터 shared·mine(boolean)·userId.
      WHERE <include refid="com.smartfirehub.analytics.repository.mybatis.DashboardVisibility.listScope"><property name="alias" value="c"/></include>
    대시보드 목록은 별칭 없는 dashboard 와 dashboardVisibleTo 를 전제하므로 자기 listScope 를 그대로 쓴다(규칙은 같다).
  -->
  <sql id="listScope">
    <choose>
      <when test="!shared and !mine">
        <include refid="com.smartfirehub.analytics.repository.mybatis.DashboardVisibility.ownedOrShared"><property name="alias" value="${alias}"/></include>
      </when>
      <otherwise>
        (1=1
        <if test="shared">AND ${alias}.is_shared = <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.sqlTrue"/></if>
        <if test="mine">AND ${alias}.created_by = #{userId}</if>)
      </otherwise>
    </choose>
  </sql>

  <!--
    이름 또는 설명 검색(대소문자 무시, WD-710 C4) — 차트·저장 쿼리·대시보드 목록·건수가 함께 쓴다. 파라미터 pattern 이 null 이면(구현이 빈 검색을
    null 로 넘긴다) 거르지 않는다. 앞에 AND 를 조각이 갖는다. 속성 alias 는 표 별칭(대시보드는 별칭 없는 표 이름 dashboard).
  -->
  <sql id="nameDescSearch">
    <if test="pattern != null">
      AND (<include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.likeIgnoreCase"><property name="col" value="${alias}.name"/></include>
           OR <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.likeIgnoreCase"><property name="col" value="${alias}.description"/></include>)
    </if>
  </sql>

</mapper>
