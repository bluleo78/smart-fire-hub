<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  tenant_settings 문장(WD-706) — JooqTenantSettingsRepository 와 같은 의미. 규칙은 MyBatisPlatformConfig javadoc.
  테넌트 정책(RLS) 대상이라 tenant_id 를 INSERT 값·WHERE 술어로 쓰지 않는다 — 넣을 때는 tenant_id DEFAULT(PG GUC, Tibero 컨텍스트)가
  채우고, 읽기·수정·삭제는 정책이 현재 테넌트 행으로 좁힌다. 쓰기 경로의 "테넌트가 반드시 있다"는 구현이 TenantContext.require 로 먼저 확인한다.
  저장 시각은 DB 시계다(PG LOCALTIMESTAMP = jOOQ currentLocalDateTime, Tibero 는 UTC 벽시계 TIMESTAMP 라 SYS_EXTRACT_UTC(SYSTIMESTAMP)).
  빈 문자열(controller Ruling): 변환하지 않는다 — value 는 NOT NULL 이라 Tibero 는 '' 를 거절한다(PG 는 '' 그대로 저장).
-->
<mapper namespace="com.smartfirehub.settings.repository.mybatis.TenantSettingsMapper">

  <resultMap id="entry" type="com.smartfirehub.settings.repository.mybatis.TenantSettingsMapper$Entry">
    <constructor>
      <arg column="key" javaType="java.lang.String"/>
      <arg column="value" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <select id="selectValue" resultType="java.lang.String">
    SELECT s.value FROM tenant_settings s WHERE s.key = #{key}
  </select>

  <select id="selectByPattern" resultMap="entry">
    SELECT s.key, s.value FROM tenant_settings s
     WHERE s.key LIKE #{pattern} ESCAPE '\'
     ORDER BY s.key ASC
  </select>

  <!-- PG: PK (tenant_id, key) 충돌이면 갱신. tenant_id 는 GUC DEFAULT 가 채운다. -->
  <insert id="upsert" databaseId="postgresql">
    INSERT INTO tenant_settings (key, value, updated_by, updated_at)
    VALUES (#{key}, #{value}, #{userId,jdbcType=BIGINT}, LOCALTIMESTAMP)
    ON CONFLICT (tenant_id, key) DO UPDATE SET
      value = EXCLUDED.value,
      updated_by = EXCLUDED.updated_by,
      updated_at = EXCLUDED.updated_at
  </insert>

  <!--
    Tibero: MERGE. 대상 테이블 읽기에 정책 술어가 붙어 ON 은 현재 테넌트 행만 만난다(다른 테넌트의 같은 키는 건드리지 않는다).
    신규 행의 tenant_id 는 컨텍스트 DEFAULT 가 채운다. 같은 키가 처음 동시에 들어오면 한쪽이 PK 위반일 수 있어 구현이 한 번 다시 시도한다.
  -->
  <insert id="upsert" databaseId="tibero">
    MERGE INTO tenant_settings t
    USING (SELECT #{key} AS k FROM DUAL) s
       ON (t.key = s.k)
    WHEN MATCHED THEN UPDATE SET
      t.value = #{value},
      t.updated_by = #{userId,jdbcType=BIGINT},
      t.updated_at = <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.dbNow"/>
    WHEN NOT MATCHED THEN INSERT (key, value, updated_by, updated_at)
      VALUES (s.k, #{value}, #{userId,jdbcType=BIGINT}, <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.dbNow"/>)
  </insert>

  <delete id="deleteByKey">
    DELETE FROM tenant_settings WHERE key = #{key}
  </delete>

  <!-- 키 목록은 구현이 500 개씩 나눠 보낸다(Tibero IN 목록 1000 개 상한). -->
  <delete id="deleteByKeys">
    DELETE FROM tenant_settings
     WHERE key IN <foreach collection="keys" item="k" open="(" separator="," close=")">#{k}</foreach>
  </delete>
</mapper>
