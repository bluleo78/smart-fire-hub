<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  dataset_category 문장(WD-707) — JooqDatasetCategoryRepository 와 같은 의미. 규칙은 MyBatisPlatformConfig javadoc.
  테넌트 정책(RLS) 대상이라 tenant_id 를 INSERT 값·WHERE 술어로 쓰지 않는다 — 넣을 때는 tenant_id DEFAULT 가 채우고 나머지는 정책이 현재 테넌트 행으로 좁힌다.
  이름 비교는 LOWER(TRIM(name)) = LOWER(#{name}) — 두 DB 공통(대소문자 변환은 DB 한 곳에서만). RETURNING 은 Tibero 에 없어 생성 키(useGeneratedKeys)로 id 를 받는다.
  빈 문자열: 변환하지 않는다 — Tibero 는 '' 를 NULL 로 저장(description 은 null 로 돌아옴, name 은 NOT NULL 이라 거절).
-->
<mapper namespace="com.smartfirehub.dataset.repository.mybatis.DatasetCategoryMapper">

  <resultMap id="categoryRow" type="com.smartfirehub.dataset.dto.CategoryResponse">
    <constructor>
      <idArg column="id" javaType="java.lang.Long"/>
      <arg column="name" javaType="java.lang.String"/>
      <arg column="description" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <select id="selectAll" resultMap="categoryRow">
    SELECT c.id, c.name, c.description FROM dataset_category c ORDER BY c.id ASC
  </select>

  <select id="selectById" resultMap="categoryRow">
    SELECT c.id, c.name, c.description FROM dataset_category c WHERE c.id = #{id}
  </select>

  <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
    INSERT INTO dataset_category (name, description)
    VALUES (#{name}, #{description,jdbcType=VARCHAR})
  </insert>

  <update id="update">
    UPDATE dataset_category
       SET name = #{name}, description = #{description,jdbcType=VARCHAR}, updated_at = #{now}
     WHERE id = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM dataset_category WHERE id = #{id}
  </delete>

  <!-- excludeId 가 있으면 그 행(수정 중인 자기 자신)은 뺀다. -->
  <select id="countByName" resultType="_int">
    SELECT COUNT(*) FROM dataset_category c WHERE LOWER(TRIM(c.name)) = LOWER(#{name})
    <if test="excludeId != null">AND c.id &lt;&gt; #{excludeId}</if>
  </select>

  <!-- 한 행만 보면 되므로 1행으로 자른 부분 질의를 센다(Tibero 는 FROM 없는 SELECT 가 없다). 가시성 조건은 걸지 않는다. -->
  <select id="countDatasetsUsing" resultType="_int">
    SELECT COUNT(*) FROM (SELECT d.id FROM dataset d WHERE d.category_id = #{categoryId}
      <include refid="com.smartfirehub.global.platformdb.mybatis.PlatformSql.limitRows"><property name="n" value="1"/></include>) x
  </select>

</mapper>
