<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  file_dataset_config 문장(WD-712) — JooqFileDatasetConfigRepository 와 같은 의미. 테넌트 정책(RLS) 대상이라 tenant_id 를 쓰지 않는다
  (넣을 때는 DEFAULT 가 채운다). 두 DB 같은 문장이라 databaseId 가 없다. bucket·prefix 는 NOT NULL 이라 빈 문자열은 Tibero 에서 거절된다(변환하지 않음).
-->
<mapper namespace="com.smartfirehub.file.repository.mybatis.FileDatasetConfigMapper">

  <resultMap id="configRow" type="com.smartfirehub.file.repository.FileDatasetConfigRepository$FileDatasetConfig">
    <constructor>
      <idArg column="dataset_id" javaType="java.lang.Long"/>
      <arg column="bucket" javaType="java.lang.String"/>
      <arg column="prefix" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <insert id="insert">
    INSERT INTO file_dataset_config (dataset_id, bucket, prefix)
    VALUES (#{datasetId}, #{bucket}, #{prefix})
  </insert>

  <select id="selectByDatasetId" resultMap="configRow">
    SELECT c.dataset_id, c.bucket, c.prefix FROM file_dataset_config c WHERE c.dataset_id = #{datasetId}
  </select>

</mapper>
