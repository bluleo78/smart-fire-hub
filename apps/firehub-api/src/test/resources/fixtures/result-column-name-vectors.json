    {"in": ["a", "a", "a"], "out": ["a", "a_2", "a_3"]},
    {"in": ["a", "a_2", "a"], "out": ["a", "a_2", "a_3"]},
    {"in": ["a", "a", "a_2"], "out": ["a", "a_3", "a_2"]},
    {"in": ["id", "id", "region", "region"], "out": ["id", "id_2", "region", "region_2"]},
