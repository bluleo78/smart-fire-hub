        }
      ]
    },
    "load": {
      "path": "/execute/load",
      "requestFields": [
        {
          "name": "tenantId",
          "required": true,
          "type": "int"
        },
        {
          "name": "table",
          "required": true,
          "type": "string"
        },
        {
          "name": "rows",
          "required": true,
          "type": "object[]"
        },
        {
          "name": "column_type_map",
          "required": false,
          "type": "object"
        },
        {
          "name": "timeout_seconds",
          "required": false,
          "type": "int"
        }
      ],
      "responseFields": [
        "success",
        "rows_loaded",
        "error",
        "db_error"
      ],
      "notes": "적재는 한 트랜잭션이다(전부 반영 또는 전부 취소). Python 실행기(PG): table 은 그 테넌트 스키마의 소문자 식별자(^[a-z][a-z0-9_]*$, rtmp_ 임시 테이블 또는 출력 테이블), 테넌트 롤 연결로 insert_batch 후 commit. db-executor(Tibero): table 은 STG_ + 16진 대문자 24자 스테이징 테이블만 허용하고 OWNER 계정으로 500행 배치 INSERT 한다. 값 변환·바인딩은 tibero-bind-vectors.json 이 고정한다. 알 수 없는 필드는 무시. Python 실행기는 Tibero 테넌트를 거부한다. timeout_seconds 는 Python 실행기에서는 문장 단위 제한(execute_values 가 페이지마다 문장을 실행해 페이지 하나에 적용), db-executor 는 요청 전체 기한이다. 값이 없으면 두 실행기 모두 기본 1800초를 쓴다. 변환 불가 값: Python 실행기는 기존 PG 변환대로 None 으로 넣고, db-executor 는 fail-closed 로 요청 전체를 실패시킨다(tibero-bind-vectors.json 참조). 빈 행·null 행은 두 실행기 모두 거부한다.",
      "examples": [
        {
          "name": "PG 적재",
          "backend": "python",
          "request": {
            "tenantId": 1,
            "table": "rtmp_ab12",
            "rows": [
              {
                "a": 1,
                "b": "x"
              }
            ],
            "column_type_map": {
              "a": "INTEGER",
              "b": "TEXT"
            }
          },
          "expectSuccess": true
        },
        {
          "name": "PG 기본 적재 제한 1800초",
          "backend": "python",
          "request": {
            "tenantId": 1,
            "table": "rtmp_ab12",
            "rows": [{"a": 1}]
          },
          "expectSuccess": true,
          "expectedStatementTimeoutMs": 1800000
        },
        {
          "name": "Tibero 스테이징 적재",
          "backend": "db-executor",
          "request": {
            "tenantId": 1,
            "table": "STG_0123456789ABCDEF01234567",
            "rows": [
              {
                "a": 1,
                "b": "x"
              }
            ],
            "column_type_map": {
              "a": "INTEGER",
              "b": "TEXT"
            }
          },
          "expectSuccess": true
        },
        {
          "name": "Tibero 기본 적재 제한 1800초",
          "backend": "db-executor",
          "request": {
            "tenantId": 1,
            "table": "STG_0123456789ABCDEF01234567",
            "rows": [{"a": 1}]
          },
          "expectSuccess": true,
          "expectedDeadlineSeconds": 1800
        },
        {
          "name": "timeout_seconds 동반",
          "backend": "python",
          "request": {
            "tenantId": 1,
            "table": "rtmp_ab12",
            "rows": [
              {
                "a": 1
              }
            ],
            "timeout_seconds": 60
          },
          "expectSuccess": true
        },
        {
          "name": "Tibero timeout_seconds 동반",
          "backend": "db-executor",
          "request": {
            "tenantId": 1,
            "table": "STG_0123456789ABCDEF01234567",
            "rows": [
              {
                "a": 1
              }
            ],
            "timeout_seconds": 60
          },
          "expectSuccess": true
        },
        {
          "name": "tenantId 누락",
          "request": {
            "table": "t1",
            "rows": [
              {
                "a": 1
              }
            ]
          },
          "expectSuccess": false,
          "expectErrorPresent": true
        },
        {
          "name": "table 누락",
          "request": {
            "tenantId": 1,
            "rows": [
              {
                "a": 1
              }
            ]
          },
          "expectSuccess": false,
          "expectErrorPresent": true
        }
      ]
    }
  }
}
