# Server Configuration
PORT=5020

# Internal Service Authentication
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# FireHub API Configuration
API_BASE_URL=http://localhost:5010/api/v1

# AI 자격증명(ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN)은 여기 두지 않는다 — 테넌트 설정(설정 › AI 에이전트)에서
# 요청마다 전달되며 서버는 ambient 값을 읽지 않는다(#708). 개발 스크립트(graphrag/dump-extraction.ts,
# graphrag/eval/run-eval.ts)만 실행 시 이 두 env 중 하나를 요구한다.

# Agent SDK Configuration
MAX_TURNS=10

# opencode 테넌트 사용 시: ambient 인증 파일(auth.json) 격리용 데이터 디렉터리.
# 개발자 개인 머신의 opencode CLI 로그인(~/.local/share/opencode)과 분리해야
# opencode-ambient-auth-guard 가 요청을 막지 않는다. 비워두면 OS 기본값(~/.local/share)을 쓴다.
# XDG_DATA_HOME=/Users/<you>/.firehub/opencode-data-local

# GraphRAG (Neo4j) — dev 기본값
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=firehub-graph-dev

# 브랜드명 (화이트라벨) — AI 어시스턴트 자기소개 등에 사용. 운영은 컨테이너 env로 주입.
BRAND_NAME=Smart Fire Hub
